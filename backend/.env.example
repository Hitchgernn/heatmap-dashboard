# Backend configuration

# Port the Express server listens on.
PORT=3001

# Repository driver: "memory" (local dev) or "hyperbase" (Hyperbase REST).
REPOSITORY_DRIVER=memory

# Seed sample data when using the memory driver.
SEED_DEV_DATA=true

# Hyperbase connection (used when REPOSITORY_DRIVER=hyperbase).
# Secrets stay server-side only — never prefix with VITE_ or expose to the frontend.
HYPERBASE_BASE_URL=http://localhost:8080
HYPERBASE_PROJECT_ID=
HYPERBASE_LOCATION_COLLECTION_ID=
HYPERBASE_TOKEN_ID=
HYPERBASE_TOKEN_SECRET=
HYPERBASE_PAGE_SIZE=500
HYPERBASE_TIMEOUT_MS=5000

# Hyperbase MOCK collection (SECOND, write-capable Hyperbase source).
# Set HYPERBASE_MOCK_COLLECTION_ID to route mock-generated data into a
# collection separate from the mobile app's (so you can observe DBSCAN
# clustering on generated data). When set on the hyperbase driver, the mock
# endpoints write here and source=mock reads back from here. The four vars
# below each override their HYPERBASE_* counterpart and fall back to it when
# empty — a same-project setup only needs HYPERBASE_MOCK_COLLECTION_ID. A
# different HYPERBASE_MOCK_PROJECT_ID needs its own token id/secret.
HYPERBASE_MOCK_COLLECTION_ID=
HYPERBASE_MOCK_BASE_URL=
HYPERBASE_MOCK_PROJECT_ID=
HYPERBASE_MOCK_TOKEN_ID=
HYPERBASE_MOCK_TOKEN_SECRET=

# Admin auth is backed by PostgreSQL (NOT Hyperbase — the HYPERBASE_AUTH_*
# vars are legacy and unused). Set DATABASE_URL, or the discrete PG* below as
# fallback. docker-compose.yml provides a matching Postgres; `npm run db:init`
# applies the schema.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=borobudur
PGPASSWORD=
PGDATABASE=borobudur_auth

# JWT signing for admin sessions.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Auth/session settings.
ADMIN_REGISTRATION_SECRET=
COOKIE_SECRET=
COOKIE_MAX_AGE_MS=86400000
