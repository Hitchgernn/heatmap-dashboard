# Backend configuration

# Port the Express server listens on.
PORT=3001

# Repository driver: "memory" (local dev) or "hyperbase" (Hyperbase REST).
REPOSITORY_DRIVER=memory

# Seed sample data when using the memory driver.
SEED_DEV_DATA=true

# Hyperbase connection (used when REPOSITORY_DRIVER=hyperbase).
# Secrets stay server-side only — never prefix with VITE_ or expose to the frontend.
HYPERBASE_BASE_URL=http://localhost:8080
HYPERBASE_PROJECT_ID=
HYPERBASE_LOCATION_COLLECTION_ID=
HYPERBASE_TOKEN_ID=
HYPERBASE_TOKEN_SECRET=
HYPERBASE_PAGE_SIZE=500
HYPERBASE_TIMEOUT_MS=5000

# Hyperbase AUTH project (admin users collection).
# The auth collection can live in a DIFFERENT Hyperbase project than the
# location data. Each var below overrides its HYPERBASE_* counterpart and
# falls back to it when empty — a single-project setup can leave all four
# blank. Tokens are project-scoped: a different HYPERBASE_AUTH_PROJECT_ID
# needs its own token id/secret.
HYPERBASE_AUTH_BASE_URL=
HYPERBASE_AUTH_PROJECT_ID=
HYPERBASE_AUTH_TOKEN_ID=
HYPERBASE_AUTH_TOKEN_SECRET=
HYPERBASE_AUTH_COLLECTION_ID=

# Auth/session settings.
ADMIN_REGISTRATION_SECRET=
COOKIE_SECRET=
COOKIE_MAX_AGE_MS=86400000
