# Backend configuration

# Port the Express server listens on.
PORT=3001

# Repository driver: "memory" (local dev) or "hyperbase" (placeholder).
REPOSITORY_DRIVER=memory

# Seed sample data when using the memory driver.
SEED_DEV_DATA=true

# Hyperbase connection (placeholder — fill in when integrating).
HYPERBASE_BASE_URL=
HYPERBASE_TOKEN=
HYPERBASE_PROJECT_ID=
HYPERBASE_COLLECTION_ID=
