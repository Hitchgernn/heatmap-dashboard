# Backend configuration

# Port the Express server listens on.
PORT=3001

# Repository driver: "memory" (local dev) or "hyperbase" (Hyperbase REST).
REPOSITORY_DRIVER=memory

# Seed sample data when using the memory driver.
SEED_DEV_DATA=true

# Hyperbase connection (used when REPOSITORY_DRIVER=hyperbase).
# Secrets stay server-side only — never prefix with VITE_ or expose to the frontend.
HYPERBASE_BASE_URL=http://localhost:8080
HYPERBASE_PROJECT_ID=
HYPERBASE_LOCATION_COLLECTION_ID=
HYPERBASE_TOKEN_ID=
HYPERBASE_TOKEN_SECRET=
HYPERBASE_PAGE_SIZE=500
HYPERBASE_TIMEOUT_MS=5000
